<Window x:Class="PhoneAudioReceiver.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Phone Audio Receiver"
        Width="384" SizeToContent="Height"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/AppIcon.ico"
        Background="Transparent"
        FontFamily="{StaticResource TextFont}" FontSize="13"
        Foreground="{DynamicResource TextPrimary}"
        UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="46" GlassFrameThickness="-1" ResizeBorderThickness="0"
                      UseAeroCaptionButtons="False" CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Border x:Name="Root">
        <StackPanel>
            <Grid Height="46" Margin="16,0,8,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="Assets/AppIcon.ico" Width="18" Height="18" />
                    <TextBlock Text="Phone Audio Receiver" Margin="10,0,0,0" FontSize="12"
                               Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="ThemeButton" Style="{StaticResource CaptionButton}" FontSize="14" />
                    <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButton}" Content="&#xE921;"
                            ToolTip="Hide to tray" />
                    <Button x:Name="CloseButton" Style="{StaticResource CloseButton}" Content="&#xE8BB;"
                            ToolTip="Close to tray" />
                </StackPanel>
            </Grid>

            <StackPanel Margin="18,2,18,18">
                <Border Style="{StaticResource Card}" Padding="20,20,20,22">
                    <StackPanel>
                        <Grid>
                            <Grid Width="52" Height="52" HorizontalAlignment="Left">
                                <Ellipse x:Name="StatusHalo" Opacity="0.16" />
                                <TextBlock x:Name="StatusGlyph" FontFamily="{StaticResource IconFont}" FontSize="22"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <StackPanel Margin="68,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="StatusText" FontFamily="{StaticResource DisplayFont}"
                                           FontWeight="SemiBold" FontSize="21" />
                                <TextBlock x:Name="DetailText" Foreground="{DynamicResource TextSecondary}"
                                           Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,20,0,0" Height="6">
                            <Border x:Name="LevelTrack" CornerRadius="3" Background="{DynamicResource TrackBrush}" />
                            <Border x:Name="LevelFill" CornerRadius="3" Width="0" HorizontalAlignment="Left"
                                    Background="{StaticResource AccentGradient}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Button x:Name="ConnectButton" Style="{StaticResource PrimaryButton}" Margin="0,12,0,0"
                        Content="Connect" />

                <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="16,4">
                    <StackPanel>
                        <Grid Margin="0,9">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource RowIcon}" Text="&#xE8EA;" />
                            <TextBlock Grid.Column="1" Text="Phone" VerticalAlignment="Center" />
                            <Button x:Name="PhoneButton" Grid.Column="2" Style="{StaticResource LinkButton}" Margin="0,0,-6,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="PhoneText" MaxWidth="180" TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="PhoneChevron" Text="&#xE70D;" FontFamily="{StaticResource IconFont}"
                                               FontSize="10" Margin="8,1,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <Border Style="{StaticResource Divider}" />
                        <Grid Margin="0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource RowIcon}" Text="&#xE7F6;" />
                            <TextBlock Grid.Column="1" Text="Output" VerticalAlignment="Center" />
                            <TextBlock x:Name="OutputText" Grid.Column="2" MaxWidth="200" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="16,4">
                    <StackPanel>
                        <Grid Margin="0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Start with Windows" />
                                <TextBlock Style="{StaticResource Caption}" Text="Opens quietly in the tray" />
                            </StackPanel>
                            <CheckBox x:Name="StartupSwitch" Grid.Column="1" Style="{StaticResource Switch}"
                                      VerticalAlignment="Center" />
                        </Grid>
                        <Border Style="{StaticResource Divider}" />
                        <Grid Margin="0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Auto-connect" />
                                <TextBlock Style="{StaticResource Caption}" Text="Connect at launch and after drops" />
                            </StackPanel>
                            <CheckBox x:Name="AutoSwitch" Grid.Column="1" Style="{StaticResource Switch}"
                                      VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
